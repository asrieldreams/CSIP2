# ── Copy this to .env and fill in your values ─────────────────────────────
# cp .env.example .env

# MySQL Workbench connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=scamwatch

# Flask secrets — change these to random strings in production
SECRET_KEY=scamwatch-secret-key-change-me
JWT_SECRET=scamwatch-jwt-secret-change-me
JWT_EXPIRY_HOURS=8

FLASK_ENV=development
FLASK_PORT=5000
