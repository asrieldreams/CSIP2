{
  "manifest_version": 3,
  "name": "CSIP2 ScamWatch Shield",
  "version": "2.0",
  "description": "Real-time scam protection. Checks URLs, emails and phone numbers against the CSIP2 community database.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "webNavigation"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [{
    "matches": [
      "http://*/*",
      "https://*/*",
      "https://mail.google.com/*",
      "https://outlook.live.com/*",
      "https://outlook.office.com/*"
    ],
    "js":      ["content.js"],
    "run_at":  "document_end"
  }],

  "web_accessible_resources": [{
    "resources": ["warning.html", "warning.js"],
    "matches":   ["<all_urls>"]
  }]
}