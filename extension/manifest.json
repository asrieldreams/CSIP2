{
  "manifest_version": 3,
  "name": "CSIP2 ScamWatch Shield",
  "version": "2.0",
  "description": "Real-time scam protection powered by CSIP2 community intelligence.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [{
    "resources": ["warning.html"],
    "matches":   ["<all_urls>"]
  }]
}